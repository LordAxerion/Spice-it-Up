																	<Action/>
																	<ActionForceNewspaper>
																		<Articles>
																			<Item>
																				<Article>2140000000</Article>
																			</Item>
																		</Articles>
																		<OpenNewspaperUI>1</OpenNewspaperUI>
																		<OpenNewspaperType>SpecialEdition</OpenNewspaperType>
																	</ActionForceNewspaper>
																</Values>
															</Action>
														</Item>
													</Actions>
												</ActionList>
											</Values>
										</DelayedActions>
									</ActionDelayedActions>
								</Values>
							</TriggerAction>
						</Item>
          </TriggerActions>
        </Trigger>
        <TriggerSetup/>
      </Values>
    </Asset>
